{
  "name": "kinowatch-samsung",
  "version": "0.2.2",
  "description": "KinoWatch for Samsung Tizen 5.5 TV",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-tizen.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-tizen.ps1",
    "release:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release.ps1",
    "lint": "eslint src/",
    "lint:css": "stylelint \"src/**/*.css\"",
    "capture:screenshots": "node scripts/capture-screenshots.mjs"
  },
  "browserslist": [
    "Chrome 69"
  ],
  "dependencies": {
    "@sentry/browser": "^10.32.1",
    "hls.js": "^1.5.20",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@preact/preset-vite": "^2.9.4",
    "@testing-library/preact": "^3.2.4",
    "eslint": "^9.39.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.1",
    "stylelint": "^17.1.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.0.6",
    "vitest": "^2.1.8",
    "ws": "^8.18.3"
  }
}
